# Variables para docker-compose.yml (la base de datos Postgres compartida por el backend).
# Copia este archivo a ".env" en la raíz del repo — docker-compose lo lee solo.
# Estos mismos valores (usuario/clave/nombre de BD) deben coincidir con el DATABASE_URL
# de gocafe_backend/.env.

POSTGRES_USER=gocafe
POSTGRES_PASSWORD=gocafe
POSTGRES_DB=gocafe
POSTGRES_PORT=5432
