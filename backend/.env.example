# Copia este archivo a ".env" (no se sube a GitHub) y completa tus valores.

# Debe coincidir con las credenciales del servicio "db" en docker-compose.yml (raíz del repo).
DATABASE_URL="postgresql://gocafe:gocafe@localhost:5432/gocafe?schema=public"

# Puerto donde corre la API.
PORT=4000

# Cambialo por un valor propio y largo (no lo compartas). Firma los tokens de sesión.
JWT_SECRET="reemplaza-esto-por-un-valor-secreto-largo"

# Origen permitido para CORS (la URL donde corre el frontend en desarrollo).
CORS_ORIGIN="http://localhost:5173"

# Usados solo por "npm run seed" para crear/actualizar el único usuario admin.
# No los compartas por chat ni los subas a GitHub.
SEED_USERNAME="gocafe"
SEED_PASSWORD="cambia-esta-contraseña"
